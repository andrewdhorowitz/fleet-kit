{
  "$id": "https://github.com/andrewdhorowitz/fleet-kit/publish-registry/publish.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "section": {
            "properties": {
              "group": {
                "const": "shared-infrastructure"
              }
            },
            "required": [
              "group"
            ]
          }
        },
        "required": [
          "section"
        ]
      },
      "then": {
        "properties": {
          "section": {
            "properties": {
              "family_visible": {
                "const": false
              }
            },
            "required": [
              "family_visible"
            ]
          }
        }
      }
    }
  ],
  "description": "One per repo, at the root. Declares which of a project's surfaces are public and which hosts must never be linked from a public surface. See PUBLISH-MANIFEST-SPEC (fleet records) and publish-registry/README.md.",
  "properties": {
    "private_hosts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "project": {
      "minLength": 1,
      "type": "string"
    },
    "public_urls": {
      "additionalProperties": false,
      "properties": {
        "demo": {
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "docs": {
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "interactive": {
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "format": "uri",
          "type": "string"
        },
        "site": {
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "site",
        "demo",
        "docs",
        "interactive",
        "repo"
      ],
      "type": "object"
    },
    "section": {
      "additionalProperties": false,
      "properties": {
        "also": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "blurb": {
                "minLength": 1,
                "type": "string"
              },
              "family_visible": {
                "default": false,
                "type": "boolean"
              },
              "group": {
                "enum": [
                  "projects",
                  "family",
                  "shared-infrastructure"
                ]
              },
              "link": {
                "format": "uri",
                "type": "string"
              },
              "name": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "name",
              "blurb",
              "link"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "blurb": {
          "minLength": 1,
          "type": "string"
        },
        "family_visible": {
          "default": false,
          "type": "boolean"
        },
        "group": {
          "enum": [
            "projects",
            "family",
            "shared-infrastructure"
          ]
        },
        "include": {
          "type": "boolean"
        }
      },
      "required": [
        "include",
        "group",
        "blurb"
      ],
      "type": "object"
    },
    "status": {
      "enum": [
        "public",
        "demo-only",
        "private"
      ]
    }
  },
  "required": [
    "project",
    "status",
    "public_urls",
    "private_hosts"
  ],
  "title": "publish.json \u2014 fleet publish manifest",
  "type": "object"
}
